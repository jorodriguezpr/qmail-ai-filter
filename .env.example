# QMAIL AI Filter - Configuration File
# Open Source Project by Jose Rodriguez Arroyo (jrpcone@gmail.com)
# Copy this to .env and fill in your actual API credentials

# ============================================
# INSTALLATION & USER CONFIGURATION
# ============================================

# The username that owns this installation (e.g., yourusername, admin)
# Used to locate the plugin directory and user's mailbox
INSTALL_USER=yourusername

# Installation directory (typically /home/{username}/qmail-ai-filter)
# Leave empty to auto-detect, or set explicitly
INSTALL_DIR=/home/yourusername/qmail-ai-filter

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================

# Available providers: 'github_copilot', 'openai', 'gemini', or 'claude_anthropic'
# GitHub Copilot is RECOMMENDED for 2026+
AI_PROVIDER=github_copilot

# GitHub Copilot Configuration (2026+ - RECOMMENDED)
# Get API token from: https://github.com/settings/tokens
# Create a "Personal access token" with 'copilot' scope
GITHUB_COPILOT_API_KEY=ghp_your-github-token-here
GITHUB_COPILOT_MODEL=gpt-4o

# OpenAI Configuration (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# Google Gemini Configuration (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-pro

# Claude Anthropic Configuration (https://console.anthropic.com/)
# CLAUDE_API_KEY=sk-ant-your-claude-api-key-here
# CLAUDE_MODEL=claude-3-haiku-20240307

# ============================================
# SPAM DETECTION CONFIGURATION
# ============================================

# Confidence threshold for marking email as spam (0.0 - 1.0)
# 0.5 = aggressive, 0.7 = balanced (recommended), 0.9 = conservative
SPAM_THRESHOLD=0.7

# Maximum email size to analyze in bytes (default: 10MB)
MAX_EMAIL_SIZE=10485760

# API request timeout in seconds
API_TIMEOUT=30

# ============================================
# QMAIL INTEGRATION
# ============================================

# QMAIL mailbox root directory (typically /home/mail on Kloxo NG)
QMAIL_MAILBOX_ROOT=/home/mail

# Automatically create .Spam folder if it doesn't exist
CREATE_SPAM_FOLDER=true

# When email is spam: false = move to .Spam, true = copy to .Spam and keep in inbox
PRESERVE_ORIGINAL=false

# ============================================
# QUEUE PROCESSING
# ============================================

# Directory where queue files are stored
QUEUE_DIR=/home/admin/qmail-ai-filter/queue

# Maximum concurrent AI API requests
MAX_CONCURRENT_REQUESTS=5

# Maximum number of retries for failed emails
MAX_RETRIES=3

# Delay in seconds between retry attempts
RETRY_DELAY=300

# ============================================
# LOGGING
# ============================================

# Log directory
LOG_DIR=/home/admin/qmail-ai-filter/logs

# Log level: 'debug', 'info', 'warning', 'error'
LOG_LEVEL=info

# Maximum log file size in bytes before rotation (default: 10MB)
LOG_MAX_SIZE=10485760

# Number of rotated log files to keep
KEEP_LOG_FILES=10

# ============================================
# DEVELOPMENT / TESTING
# ============================================

# Enable debug logging
DEBUG=false

# Dry-run mode: analyze but don't move emails to Spam
DRY_RUN=false

# Test mode: use mock AI responses (for development only)
TEST_MODE=false
